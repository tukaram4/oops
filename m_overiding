class Animal:
    def speak(self):
        return "Some generic animal sound"

class Dog(Animal):
    def speak(self):
        return "Woof! 🐶"

class Cat(Animal):
    def speak(self):
        return "Meow! 🐱"

# The correct method is resolved at runtime based on the object
animals = [Dog(), Cat(), Animal()]
for animal in animals:
    print(animal.speak())
